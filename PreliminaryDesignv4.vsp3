      <CustomGeom>
        <Width Value="1.814463636363636390e+00" ID="ETQUXRUUJPY"/>
        <SeatHeight Value="1.600390909090908975e+00" ID="TVYKSKFWZGA"/>
        <SeatLength Value="1.575849999999999973e+00" ID="GRSBCNBNGSH"/>
        <BackHeight Value="3.200709090909091170e+00" ID="EWZFUTHKHQD"/>
